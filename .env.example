# 服务器配置
PORT=3000
NODE_ENV=development

# 阿里云 OSS 配置
ALI_OSS_REGION=oss-cn-hangzhou
ALI_OSS_ACCESS_KEY_ID=your_access_key_id
ALI_OSS_ACCESS_KEY_SECRET=your_access_key_secret
ALI_OSS_BUCKET=your_bucket_name

# 腾讯云 COS 配置
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key
TENCENT_BUCKET=your_bucket_name-1234567890
TENCENT_REGION=ap-guangzhou

# AWS S3 配置
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-west-2
AWS_BUCKET=your_bucket_name

# 数据库配置（可选，用于存储文件信息）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=image_upload
DB_USER=root
DB_PASSWORD=password

# JWT 密钥（可选，用于用户认证）
JWT_SECRET=your_jwt_secret_key

# Redis 配置（可选，用于缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 文件存储配置
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
MAX_FILES=10

# CORS 配置
CORS_ORIGIN=http://localhost:8000,http://localhost:3000